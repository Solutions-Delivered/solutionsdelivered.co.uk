<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Set the colour theme before paint to avoid a flash. #}
    <script>
    (function () {
        try {
            var stored = localStorage.getItem('sd-theme');
            var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
            /* default to light */
        }
        /* Returning visitors who already accepted never see the banner flash. */
        if (document.cookie.split('; ').indexOf('{{ site.consentCookie }}=1') !== -1) {
            document.documentElement.classList.add('cookie-consented');
        }
    })();
    </script>

    {# Google Analytics 4 (gtag), gated on cookie consent via Consent Mode v2.
       analytics_storage stays denied until the visitor accepts cookies. #}
    {% if site.analyticsEnabled and site.ga4Id %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4Id }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
        });
        if (document.cookie.split('; ').indexOf('{{ site.consentCookie }}=1') !== -1) {
            gtag('consent', 'update', { analytics_storage: 'granted' });
        }
        gtag('config', '{{ site.ga4Id }}');
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-cookie-consent-agree').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    gtag('consent', 'update', { analytics_storage: 'granted' });
                });
            });
        });
    </script>
    {% endif %}

    <meta name="description" content="{{ meta_description or brand.company.description }}">
    <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">

    {# Browser UI colour, per theme. #}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#13161c" media="(prefers-color-scheme: dark)">

    <title>{{ title or (brand.company.name ~ ' | ' ~ brand.company.tagline) }}</title>

    {# Favicons: the SD monogram. The ?v query busts caches when the icon files change. #}
    <link rel="icon" type="image/svg+xml" href="/favicon-sd.svg?v={{ site.iconVersion }}">
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v={{ site.iconVersion }}">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v={{ site.iconVersion }}">

    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}

    {# Preload the two most-used font cuts. #}
    <link rel="preload" href="/fonts/hanken-grotesk-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/hanken-grotesk-600.woff2" as="font" type="font/woff2" crossorigin>

    {% block head %}{% endblock %}

    {# Open Graph #}
    <meta property="og:title" content="{{ og_title or brand.company.name }}">
    <meta property="og:description" content="{{ og_description or brand.company.description }}">
    <meta property="og:type" content="{{ og_type or 'website' }}">
    {% if canonicalUrl %}<meta property="og:url" content="{{ canonicalUrl }}">{% endif %}
    <meta property="og:image" content="{{ abs('og-image.png') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="{{ brand.company.name }}">
    <meta property="og:locale" content="en_GB">

    {# Twitter #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ twitter_title or brand.company.name }}">
    <meta name="twitter:description" content="{{ twitter_description or brand.company.description }}">
    <meta name="twitter:image" content="{{ abs('og-image.png') }}">

    {# Organisation schema #}
    <script type="application/ld+json">
    {{ ld({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: brand.company.legal_name,
        legalName: brand.company.legal_name,
        url: site.url,
        logo: site.url ~ '/logo.svg',
        description: brand.company.description,
        foundingDate: brand.company.founded,
        address: {
            '@type': 'PostalAddress',
            streetAddress: brand.company.address.street,
            addressLocality: brand.company.address.locality,
            addressRegion: brand.company.address.region,
            postalCode: brand.company.address.postcode,
            addressCountry: brand.company.address.country
        },
        contactPoint: {
            '@type': 'ContactPoint',
            contactType: 'Customer Service',
            email: brand.contact.general,
            url: route('contact')
        },
        areaServed: { '@type': 'Country', name: 'United Kingdom' },
        vatID: brand.company.vat_number,
        identifier: {
            '@type': 'PropertyValue',
            name: 'UK company registration number',
            value: brand.company.company_number
        },
        sameAs: compact(['https://find-and-update.company-information.service.gov.uk/company/' ~ brand.company.company_number, brand.social.linkedin]),
        knowsAbout: ['Practical AI for business', 'AI adoption', 'Web development', 'Project management', 'ITIL service management', 'Business change']
    }) | safe }}
    </script>

    {# WebSite schema #}
    <script type="application/ld+json">
    {{ ld({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: brand.company.name,
        url: site.url,
        publisher: { '@type': 'Organization', name: brand.company.legal_name }
    }) | safe }}
    </script>

    {% block schema %}{% endblock %}

    <link rel="stylesheet" href="/assets/app.css?v={{ assets.css }}">
</head>
<body class="min-h-screen bg-bg text-text antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {% include "partials/header.njk" %}

    <main id="main-content" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    {% include "partials/footer.njk" %}

    {% include "partials/cookie-consent.njk" %}

    <script src="/assets/alpine.js?v={{ assets.alpine }}" defer></script>
    <script src="/assets/app.js?v={{ assets.js }}"></script>
</body>
</html>
