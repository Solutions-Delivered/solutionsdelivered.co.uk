---
title: "Guides | Solutions Delivered"
meta_description: "Practical guides on outsourced IT leadership, continuity, Cyber Essentials, ISO 27001 and AI adoption for small businesses."
navKey: guides.index
---
{% extends "layouts/app.njk" %}
{% from "components.njk" import button, card, eyebrow, faq, faq_item, offer_card, page_header, process_step, section_heading, brand_monogram, schema_breadcrumb, error_page, field with context %}
{% block schema %}
{{ schema_breadcrumb({ items: [{ 'name': 'Home', 'url': route('home') }, { 'name': 'Guides' }] }) }}
{% endblock %}
{% block content %}
{% call page_header({ eyebrow: 'Guides', title: 'Guides for owner-managed businesses', lead: 'Practical, plain-English guides on the technology decisions small businesses face: outsourced IT leadership, continuity, compliance and AI adoption.' }) %}{% endcall %}

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    {% if guides.length == 0 %}
        <p class="text-muted">No guides published yet. Check back soon.</p>
    {% else %}
        <div class="space-y-14">
            {% for clusterSlug, cluster in guide_clusters %}
                {% set clusterGuides = guides | byCluster(clusterSlug) %}
                {% if clusterGuides.length %}
                <div>
                    {% call section_heading({ lead: cluster.description }) %}
                        {{ cluster.label }}
                    {% endcall %}

                    <div class="mt-6 grid gap-4 sm:grid-cols-2">
                        {% for guide in clusterGuides %}
                            {% call card() %}
                                <a href="{{ route('guides.show', guide.slug) }}" class="block">
                                    <h3 class="font-semibold text-ink">{{ guide.title }}</h3>
                                    <p class="mt-2 text-sm leading-relaxed text-muted">{{ guide.description }}</p>
                                    <time class="mt-3 block text-xs text-muted" datetime="{{ guide.dateIso }}">
                                        {{ guide.dateLabel }}
                                    </time>
                                </a>
                            {% endcall %}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
