---
pagination:
  data: guides
  size: 1
  alias: guide
permalink: "/guides/{{ guide.slug }}/"
navKey: none
eleventyComputed:
  title: "{{ guide.title | safe }} | Solutions Delivered"
  meta_description: "{{ guide.description | safe }}"
  og_title: "{{ guide.title | safe }}"
  og_description: "{{ guide.description | safe }}"
  og_type: article
  twitter_title: "{{ guide.title | safe }}"
  twitter_description: "{{ guide.description | safe }}"
---
{% extends "layouts/app.njk" %}
{% from "components.njk" import button, card, eyebrow, faq, faq_item, offer_card, page_header, process_step, section_heading, brand_monogram, schema_breadcrumb, error_page, field with context %}
{% block schema %}
{{ schema_breadcrumb({ items: [{ 'name': 'Home', 'url': route('home') }, { 'name': 'Guides', 'url': route('guides.index') }, { 'name': guide.title }] }) }}
<script type="application/ld+json">
{{ ld({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    url: route('guides.show', guide.slug),
    mainEntityOfPage: { '@type': 'WebPage', '@id': route('guides.show', guide.slug) },
    datePublished: guide.datePublished,
    dateModified: guide.dateModified,
    author: { '@type': 'Organization', name: brand.company.legal_name, url: site.url },
    publisher: { '@type': 'Organization', name: brand.company.legal_name, url: site.url }
}) | safe }}
</script>
{% endblock %}
{% block content %}
{% call page_header({ eyebrow: (guide_clusters[guide.cluster].label or 'Guides'), title: guide.title }) %}{% endcall %}

<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
        <time datetime="{{ guide.dateIso }}">{{ guide.dateLabel }}</time>
        {% if guide.wasUpdated %}
            <span>Updated {{ guide.updatedLabel }}</span>
        {% endif %}
    </div>

    <div class="legal">
        {{ guide.html | safe }}
    </div>

    <div class="mt-14 border-t border-border pt-10">
        {% call button({ href: route('contact') }) %}Talk to us{% endcall %}
    </div>
</section>
{% endblock %}
